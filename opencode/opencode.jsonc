{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@plannotator/opencode@latest"],
  "mcp": {
    "temporal-docs": {
      "type": "remote",
      "url": "https://temporal.mcp.kapa.ai",
      "enabled": false
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": false
    }
  },
  "agent": {
    "plan": {
      "model": "anthropic/claude-opus-4-8",
      "variant": "xhigh",
      "color": "accent"
    },
    "build": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "color": "success"
    }
  },
  "lsp": true
}
